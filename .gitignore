# Track only the active strawberry projects and their maintenance documents.
/*
!/.gitignore
!/AGENTS.md
!/WORKSPACE.md
!/Newsmart-Strawberry/
!/strawberry_project/
!/strawberry_vision/
!/packaging/
!/学生版本同步/

# Local environments, generated files, and editor state.
**/.venv/
**/.venv_new/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.idea/
**/.vscode/
**/.run/
**/dist/
**/.DS_Store
**/Thumbs.db
*.py[cod]
*.log
*.zip
*.rar
*.7z
*.tar
*.gz
*.bak
*.tmp

# Credentials and machine-local settings remain on disk, outside Git.
**/.env
**/.env.*
!**/.env.template
!**/.env.example
!**/.env.test.example
**/classroom.env
**/sandbox.env
**/local.env
**/*.pem
**/*.key
**/LOGIN.txt
**/pg-password.txt

# Business data, training inputs/results, model binaries, and QA copies.
**/.runtime/
**/saves/
**/saves_dev/
*.pt
*.pth
*.onnx
*.engine
*.dump
*.sqlite
*.sqlite3
*.db
/Newsmart-Strawberry/data/
/Newsmart-Strawberry/strawberry_detector/models/
/Newsmart-Strawberry/strawberry_detector/results/
/Newsmart-Strawberry/strawberry_detector/uploads/
/Newsmart-Strawberry/student_replace_patch/
/Newsmart-Strawberry/docx/
/Newsmart-Strawberry/deliverables/
/Newsmart-Strawberry/mqtt_extracted.txt
/Newsmart-Strawberry/*.docx
/Newsmart-Strawberry/docs/*.docx
/Newsmart-Strawberry/docs/*.pptx
/strawberry_project/images/
/strawberry_project/output/
/strawberry_vision/annotation_review_v01/
/strawberry_vision/annotations_draft.json
/strawberry_vision/dataset*/
/strawberry_vision/downloads/
/strawberry_vision/runs/
/strawberry_vision/weights/
/packaging/.qa-*/
